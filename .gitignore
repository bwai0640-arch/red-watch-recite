# Installed dependencies and package-manager caches
/node_modules/
/.pnpm-store/
/.electron-cache/
/.cache/

# Local build and release outputs
/dist/
/release-staging/
*.exe

# Runtime data and local speaker profiles (match every nested copy)
/RedWatchReciteData/
**/RedWatchReciteData/
**/speaker-profile.dat*
**/study-preferences.json
**/window-preferences.json
**/TransientElectronData/
**/SessionData/
**/Code Cache/
**/GPUCache/

# Local audit artifacts and real-person test recordings
/work/
*.wav

# Local environment files; sanitized examples remain eligible for tracking
.env
.env.*
!.env.example
!.env.*.example

# Logs, temporary files and common OS/editor caches
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
/logs/
/tmp/
/temp/
.DS_Store
Thumbs.db
Desktop.ini
