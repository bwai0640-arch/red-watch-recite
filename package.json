{
  "name": "red-watch-recite",
  "version": "1.13.4",
  "description": "凛冬督学局：本地背书与安静自习监督桌面应用",
  "main": "main.js",
  "author": "原作：叛逆蓝牙 · 二创：眼泪斷了线",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-release.cjs",
    "dist:installer": "node scripts/build-release.cjs",
    "test:window-modes": "node scripts/window-mode-policy-test.cjs && node scripts/floating-window-source-test.cjs",
    "test:speaker-runtime": "node scripts/speaker-runtime-policy-test.cjs && node scripts/speaker-service-test.cjs",
    "test:adversarial": "node scripts/adversarial-user-simulation-test.cjs",
    "test:settings": "node scripts/study-settings-policy-test.cjs && node scripts/study-settings-source-test.cjs"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.4"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "top.redwatch.study-supervisor",
    "productName": "凛冬督学局",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "window-mode-policy.js",
      "study-settings-policy.js",
      "cache-cleanup.js",
      "preload.js",
      "profile-crypto.js",
      "break-prompt-preload.js",
      "speaker-service.js",
      "speaker-worker.js",
      "audio-event-service.js",
      "audio-event-worker.js",
      "renderer/**/*",
      "models/**/*",
      "assets/**/*",
      "LICENSES/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "speaker-worker.js",
      "audio-event-worker.js",
      "models/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "凛冬督学局-安装版-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "凛冬督学局",
      "deleteAppDataOnUninstall": false
    }
  }
}
